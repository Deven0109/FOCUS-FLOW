<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="/javascripts/controllers/calendarController.js?v=<%= Date.now() %>"></script>
<link href='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.css' rel='stylesheet' />
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
<style>
    /* FullCalendar Customization */
    .fc-header-toolbar {
        margin-bottom: 1.5rem !important;
        padding: 0.5rem;
    }

    .fc-event {
        border-radius: 4px;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        border: none;
        font-size: 0.85em;
        font-weight: 500;
        cursor: pointer;
        transition: transform 0.1s ease-in-out;
    }

    .fc-event:hover {
        transform: scale(1.01);
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        z-index: 50;
    }

    .fc .fc-button-group>.fc-button {
        background-color: #fff;
        border: 1px solid #e2e8f0;
        color: #64748b;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
        padding: 0.5rem 1rem;
        font-weight: 500;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: capitalize;
    }

    .fc .fc-button-group>.fc-button:hover {
        background-color: #f8fafc;
        border-color: #cbd5e1;
        color: #0f172a;
        z-index: 2;
    }

    .fc .fc-button-group>.fc-button:focus,
    .fc .fc-button-group>.fc-button:active,
    .fc .fc-button-primary:not(:disabled).fc-button-active {
        background-color: #f1f5f9 !important;
        border-color: #94a3b8 !important;
        color: #0f172a !important;
        box-shadow: none !important;
        outline: none !important;
    }

    /* Icons in buttons */
    .fc-icon {
        font-size: 1.2em;
        vertical-align: middle;
    }

    .fc-theme-standard td,
    .fc-theme-standard th {
        border-color: #e2e8f0;
    }

    .fc-daygrid-day {
        cursor: pointer;
        transition: background-color 0.2s;
    }

    .fc-daygrid-day:hover {
        background-color: #f0f9ff;
        /* Light blue hover */
    }

    .fc-event-main {
        padding: 0 !important;
    }

    /* Fix Dropdown Visibility */
    .modal-body {
        overflow-y: visible !important;
        /* Allow dropdowns to overflow */
    }

    .form-select-lg {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%23343a40' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='M2 5l6 6 6-6'/%3e%3c/svg%3e");
        background-repeat: no-repeat;
        background-position: right 0.75rem center;
        background-size: 16px 12px;
    }

    /* Toolbar Title */
    .fc-toolbar-title {
        font-size: 1.5rem !important;
        font-weight: 700;
        color: #1e293b;
    }

    /* Sunday Weekend Highlighting */
    .fc-day-sun {
        background-color: #f1f5f9 !important;
        /* Professional Light Gray */
        position: relative;
    }

    .fc-day-sun::after {
        content: 'WEEKEND';
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) rotate(-30deg);
        font-size: 1.5rem;
        font-weight: 900;
        color: rgba(100, 116, 139, 0.1);
        /* Faint Gray */
        pointer-events: none;
        letter-spacing: 5px;
        z-index: 0;
    }

    /* Ensure day numbers stay above the weekend text */
    .fc-daygrid-day-top {
        position: relative;
        z-index: 1;
    }
</style>
<div class="container-fluid" ng-controller="CalendarController">
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <div class="page-pretitle text-muted">Leave Management</div>
                <h1 class="page-title mb-1">Leave Calendar</h1>
                <p class="text-muted mb-0">View and manage leave plans for all team members</p>
            </div>
            <div class="col-auto">
                <button class="btn btn-primary" ng-click="showMyLeaves()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="16" y1="2" x2="16" y2="6"></line>
                        <line x1="8" y1="2" x2="8" y2="6"></line>
                        <line x1="3" y1="10" x2="21" y2="10"></line>
                    </svg>
                    My Leaves
                </button>
            </div>
        </div>
    </div>

    <!-- Calendar Card -->
    <div class="row">
        <!-- Pending Requests Sidebar (Admin Only) -->
        <div class="col-lg-3 mb-3" ng-if="isAdmin">
            <div class="card shadow-sm h-100" style="border: none;">
                <div class="card-header bg-white border-bottom py-3">
                    <h3 class="card-title mb-0 text-primary fw-bold">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-bell-ringing me-2"
                            width="20" height="20" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"
                            fill="none" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path
                                d="M10 5a2 2 0 0 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6">
                            </path>
                            <path d="M9 17v1a3 3 0 0 0 6 0v-1"></path>
                            <path d="M21 5h-4l3 3"></path>
                        </svg>
                        Requests ({{pendingLeaves.length}})
                    </h3>
                </div>
                <div class="card-body p-0 overflow-auto" style="max-height: 600px;">
                    <div ng-if="pendingLeaves.length === 0" class="text-center p-4 text-muted">
                        <div class="mb-2">🎉</div>
                        No pending requests
                    </div>
                    <div class="list-group list-group-flush">
                        <div class="list-group-item" ng-repeat="leave in pendingLeaves">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold">{{leave.user.name}}</span>
                                <span class="badge"
                                    ng-class="{'bg-success': leave.user.workType === 'onsite', 'bg-info': leave.user.workType === 'remote'}">
                                    {{leave.user.workType | uppercase}}
                                </span>
                            </div>
                            <div class="text-muted small mb-2">
                                <div class="d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg"
                                        class="icon icon-tabler icon-tabler-calendar-event me-1" width="14" height="14"
                                        viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" fill="none"
                                        stroke-linecap="round" stroke-linejoin="round">
                                        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                                        <rect x="4" y="5" width="16" height="16" rx="2"></rect>
                                        <line x1="16" y1="3" x2="16" y2="7"></line>
                                        <line x1="8" y1="3" x2="8" y2="7"></line>
                                        <line x1="4" y1="11" x2="20" y2="11"></line>
                                        <rect x="8" y="15" width="2" height="2"></rect>
                                    </svg>
                                    {{leave.fromDate | date:'dd MMM'}} - {{leave.toDate | date:'dd MMM'}}
                                </div>
                                <div class="mt-1 text-truncate" title="{{leave.reason}}">{{leave.reason}}</div>
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-sm btn-outline-success flex-grow-1"
                                    ng-click="updateLeaveStatus(leave._id, 'approved')">
                                    Approve
                                </button>
                                <button class="btn btn-sm btn-outline-danger flex-grow-1"
                                    ng-click="updateLeaveStatus(leave._id, 'rejected')">
                                    Cancel
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Main Calendar -->
        <div ng-class="{'col-lg-9': isAdmin, 'col-12': !isAdmin}">
            <div class="card shadow-sm" style="border: none;">
                <div class="card-header bg-white border-bottom py-3">
                    <div class="d-flex justify-content-between align-items-center w-100">
                        <div class="d-flex align-items-center">
                            <h3 class="card-title mb-0 d-flex align-items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-2 text-primary">
                                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                    <line x1="16" y1="2" x2="16" y2="6"></line>
                                    <line x1="8" y1="2" x2="8" y2="6"></line>
                                    <line x1="3" y1="10" x2="21" y2="10"></line>
                                </svg>
                                Team Leave Calendar
                            </h3>
                        </div>

                        <div class="d-flex align-items-center gap-4">
                            <!-- Work Type Filter -->
                            <div class="d-flex align-items-center" ng-if="isAdmin">
                                <label class="form-label mb-0 me-2 fw-bold text-dark text-uppercase"
                                    style="font-size: 1rem;">Work Type:</label>
                                <select class="form-select border-2 fw-bold"
                                    style="width: 160px; height: 45px; font-size: 1rem;" ng-model="filters.workType"
                                    ng-change="onWorkTypeChange()">
                                    <option value="all">All Employees</option>
                                    <option value="onsite">Onsite</option>
                                    <option value="remote">Remote</option>
                                </select>
                            </div>

                            <!-- Legend Section -->
                            <div class="d-flex align-items-center gap-3 border-start ps-4">
                                <div class="d-flex align-items-center">
                                    <span class="rounded-circle me-1"
                                        style="width: 14px; height: 14px; background-color: rgba(13, 110, 253, 0.4); display: inline-block;"></span>
                                    <span class="fw-bold text-secondary" style="font-size: 0.9rem;">Casual</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="rounded-circle me-1"
                                        style="width: 14px; height: 14px; background-color: rgba(220, 53, 69, 0.4); display: inline-block;"></span>
                                    <span class="fw-bold text-secondary" style="font-size: 0.9rem;">Sick</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="rounded-circle me-1"
                                        style="width: 14px; height: 14px; background-color: rgba(25, 135, 84, 0.4); display: inline-block;"></span>
                                    <span class="fw-bold text-secondary" style="font-size: 0.9rem;">Vacation</span>
                                </div>
                                <div class="d-flex align-items-center">
                                    <span class="rounded-circle me-1"
                                        style="width: 14px; height: 14px; background-color: rgba(253, 126, 20, 0.4); display: inline-block;"></span>
                                    <span class="fw-bold text-secondary" style="font-size: 0.9rem;">Personal</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-body position-relative" style="min-height: 600px;">
                    <!-- Loading Overlay -->
                    <div ng-if="calendarLoading" class="position-absolute top-50 start-50 translate-middle text-center">
                        <div class="spinner-border text-primary mb-2" role="status"></div>
                        <div class="text-muted">Loading calendar...</div>
                    </div>
                    <div id="calendar" ng-class="{'opacity-50': calendarLoading}"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Legend Card Removed (All leaves are standard blue) -->

    <!-- Leave Request Modal -->
    <div class="modal modal-blur fade" id="leaveModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title d-flex align-items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" class="me-2">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        Leave Form
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="leaveForm">
                        <div class="row mb-3">
                            <div class="col-12 mb-3">
                                <label class="form-label required d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                        <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                        <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                    </svg>
                                    Title
                                </label>
                                <input type="text" class="form-control" ng-model="leaveForm.title"
                                    placeholder="e.g. Summer Vacation, Doctor Appointment" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label required d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                                        <line x1="16" y1="2" x2="16" y2="6"></line>
                                        <line x1="8" y1="2" x2="8" y2="6"></line>
                                        <line x1="3" y1="10" x2="21" y2="10"></line>
                                    </svg>
                                    Leave Duration
                                </label>
                                <select class="form-select" ng-model="leaveForm.duration"
                                    ng-change="onDurationChange()">
                                    <option value="single">Single Day</option>
                                    <option value="multiple">Multiple Days</option>
                                </select>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label required d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    <span ng-if="leaveForm.duration === 'single'">Date</span>
                                    <span ng-if="leaveForm.duration === 'multiple'">From Date</span>
                                </label>
                                <input type="date" class="form-control" ng-model="leaveForm.fromDate"
                                    ng-change="onFromDateChange()" required>
                            </div>
                            <div class="col-md-6 mb-3" ng-show="leaveForm.duration === 'multiple'">
                                <label class="form-label required d-flex align-items-center">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                        <circle cx="12" cy="12" r="10"></circle>
                                        <polyline points="12 6 12 12 16 14"></polyline>
                                    </svg>
                                    To Date
                                </label>
                                <input type="date" class="form-control" ng-model="leaveForm.toDate"
                                    ng-required="leaveForm.duration === 'multiple'">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label required d-flex align-items-center">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                    <path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path>
                                    <line x1="4" y1="22" x2="4" y2="15"></line>
                                </svg>
                                Leave Type
                            </label>
                            <select class="form-select" ng-model="leaveForm.leaveType" required>
                                <option value="casual">Casual Leave</option>
                                <option value="sick">Sick Leave</option>
                                <option value="vacation">Vacation</option>
                                <option value="personal">Personal Leave</option>
                            </select>
                        </div>

                        <div class="mb-2">
                            <label class="form-label required fw-bold text-uppercase small text-muted mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                                Reason for Leave
                            </label>
                            <textarea class="form-control border-2" rows="4" ng-model="leaveForm.reason"
                                placeholder="Please describe why you need this leave..." required
                                style="resize: none;"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light p-3 border-top-0">
                    <button type="button" class="btn btn-light text-muted fw-bold px-4" data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary px-5 fw-bold shadow-sm" ng-click="submitLeave()"
                        ng-disabled="isSubmitting">
                        <span ng-if="isSubmitting" class="spinner-border spinner-border-sm me-2" role="status"
                            aria-hidden="true"></span>
                        <span ng-if="!isSubmitting">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                                <polyline points="20 6 9 17 4 12"></polyline>
                            </svg>
                            Submit Leave
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- View Leave Details Modal -->
    <div class="modal modal-blur fade" id="viewLeaveModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-light p-3">
                    <h3 class="modal-title d-flex align-items-center fw-bold text-dark fs-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" class="me-2 text-primary">
                            <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                            <path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6">
                            </path>
                        </svg>
                        Leaves for <span id="viewLeaveDate" class="ms-2 text-primary"></span>
                    </h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="list-group list-group-flush" id="dayLeavesList">
                        <!-- Leaves will be populated here -->
                    </div>
                </div>
                <div class="modal-footer bg-light p-2 border-top-0">
                    <button type="button" class="btn btn-secondary w-100" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- My Leaves Modal -->
    <div class="modal modal-blur fade" id="myLeavesModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-info text-white">
                    <h5 class="modal-title">My Leave History</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th style="width: 100px;">From</th>
                                    <th style="width: 100px;">To</th>
                                    <th>Title</th>
                                    <th>Type</th>
                                    <th>Reason</th>
                                    <th style="width: 80px;" class="text-center">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr ng-if="myLeaves.length === 0">
                                    <td colspan="5" class="text-center text-muted">No leaves found</td>
                                </tr>
                                <tr ng-repeat="leave in myLeaves">
                                    <td>{{leave.fromDate | date:'dd/MM/yy'}}</td>
                                    <td>{{leave.toDate | date:'dd/MM/yy'}}</td>
                                    <td class="fw-bold">{{leave.title || '-'}}</td>
                                    <td>
                                        <span class="badge text-white"
                                            ng-style="{'background-color': getLeaveColor(leave.leaveType)}">
                                            {{(leave.leaveType || 'Leave') | uppercase}}
                                        </span>
                                    </td>
                                    <td>{{leave.reason}}</td>
                                    <td class="text-center">
                                        <button class="btn btn-icon btn-danger btn-sm shadow-sm"
                                            ng-if="canDeleteLeave(leave.fromDate)" ng-click="deleteLeave(leave._id)"
                                            title="Delete Leave Request">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path
                                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                </path>
                                            </svg>
                                        </button>
                                        <button class="btn btn-icon btn-secondary btn-sm opacity-50"
                                            ng-if="!canDeleteLeave(leave.fromDate)" style="cursor: not-allowed;"
                                            title="Past or current leaves cannot be deleted">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                                stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path
                                                    d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                                </path>
                                            </svg>
                                        </button>
                                    </td>
                                </tr>
