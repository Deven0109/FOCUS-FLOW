<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="/javascripts/controllers/noticeController.js"></script>
<div class="container-fluid" ng-controller="NoticeController">
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <div class="page-pretitle text-muted">COMMUNICATIONS</div>
                <h1 class="page-title mb-1">Notice Board</h1>
                <p class="text-muted mb-0 small">View and manage company notices</p>
            </div>
            <!-- HR Only: Add Notice Button -->
            <div class="col-auto" ng-if="isHR">
                <button class="btn btn-primary" ng-click="openAddModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add Notice
                </button>
            </div>
        </div>
    </div>

    <div class="page-body">
        <!-- Empty State -->
        <div ng-if="notices.length === 0" class="empty">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                    <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
                    <line x1="9" y1="9" x2="10" y2="9" />
                    <line x1="9" y1="13" x2="15" y2="13" />
                    <line x1="9" y1="17" x2="15" y2="17" />
                </svg>
            </div>
            <p class="empty-title">No notices available</p>
            <p class="empty-subtitle text-muted">Click Add Notice to create your first notice</p>
        </div>

        <!-- Professional Notices Card Grid -->
        <div ng-if="notices.length > 0" class="row row-deck row-cards">
            <div class="col-md-6 col-lg-4" ng-repeat="notice in getPaginatedNotices() track by notice._id">
                <div class="card card-sm shadow-sm border-0 h-100 transition-all hover-shadow-lg"
                    style="border-radius: 12px; transition: all 0.3s ease;">
                    <div class="card-body d-flex flex-column p-3">
                        <!-- Top Row: Date and Badge -->
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-muted fw-medium" style="font-size: 0.75rem; letter-spacing: 0.02em;">
                                <i class="fa-regular fa-calendar-check me-1"></i>
                                {{notice.createdAt | date:'dd MMM yyyy'}}
                            </span>
                            <span class="badge rounded-pill px-2 py-1" ng-class="{
                                'bg-blue-lt': notice.workTypeFilter === 'all',
                                'bg-green-lt': notice.workTypeFilter === 'onsite',
                                'bg-orange-lt': notice.workTypeFilter === 'remote'
                            }" style="font-size: 0.65rem; font-weight: 700;">
                                {{notice.workTypeFilter | uppercase}}
                            </span>
                        </div>

                        <!-- Title -->
                        <h3 class="card-title fw-bold mb-1 text-dark"
                            style="font-size: 1.1rem; line-height: 1.3; color: #1e293b !important;">
                            {{notice.title}}
                        </h3>

                        <!-- Author Info (Subtle) -->
                        <div class="d-flex align-items-center mb-2">
                            <div class="avatar avatar-xs rounded-circle me-2 bg-primary-lt fw-bold"
                                style="font-size: 0.6rem; width: 20px; height: 20px;">
                                {{notice.createdBy.name.charAt(0)}}
                            </div>
                            <span class="text-muted" style="font-size: 0.75rem;">By {{notice.createdBy.name}}</span>
                        </div>

                        <!-- Content Area -->
                        <div class="flex-grow-1">
                            <p class="text-secondary mb-2"
                                style="font-size: 0.9rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; color: #475569 !important;">
                                {{notice.content}}
                            </p>
                        </div>

                        <!-- Attachment and Target Metadata -->
                        <div class="mt-2">
                            <div class="d-flex flex-column align-items-start gap-2 w-100">
                                <!-- Target Count -->
                                <div class="d-flex align-items-center text-muted" title="Target Audience">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" class="me-1 opacity-50">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                    </svg>
                                    <span style="font-size: 0.75rem;">
                                        {{ (notice.targetEmployees && notice.targetEmployees.length > 0) ?
                                        notice.targetEmployees.length : 'All Employees' }}
                                    </span>
                                </div>

                                <!-- Clickable File Chip -->
                                <div ng-if="notice.fileName" style="max-width: 100%;">
                                    <a ng-href="{{notice.fileUrl}}" target="_blank"
                                        class="d-flex align-items-center px-2 py-1 bg-light rounded-2 border text-dark text-decoration-none transition-all hover-bg-primary-lt"
                                        style="font-size: 0.7rem; white-space: normal; word-break: break-all; width: fit-content;"
                                        title="Click to view {{notice.fileName}}">
                                        <i class="fa-solid me-1"
                                            ng-class="notice.fileType === 'pdf' ? 'fa-file-pdf text-danger' : 'fa-file-image text-primary'"></i>
                                        <span>{{notice.fileName}}</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Refined Action Bar -->
                    <div class="card-footer bg-transparent border-top-0 px-4 pb-4 pt-0 d-flex gap-2">
                        <button
                            class="btn btn-primary w-100 fw-bold shadow-none d-flex align-items-center justify-content-center"
                            ng-click="viewNotice(notice)" style="border-radius: 8px; height: 38px;">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                                <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            View
                        </button>

                        <div class="d-flex gap-2" ng-if="isHR">
                            <button class="btn btn-icon btn-outline-light text-primary border shadow-none"
                                ng-click="editNotice(notice)" title="Edit"
                                style="border-radius: 8px; width: 38px; height: 38px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                    <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                </svg>
                            </button>
                            <button class="btn btn-icon btn-outline-light text-danger border shadow-none"
                                ng-click="deleteNotice(notice)" title="Delete"
                                style="border-radius: 8px; width: 38px; height: 38px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M3 6h18"></path>
                                    <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                                    <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                                </svg>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pagination Controls -->
        <div class="d-flex justify-content-center mt-4 mb-5" ng-if="getTotalPages() > 1">
            <nav>
                <ul class="pagination shadow-sm">
                    <li class="page-item" ng-class="{'disabled': currentPage === 1}">
                        <a class="page-link" href="javascript:void(0)" ng-click="setPage(currentPage - 1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" class="icon">
                                <path d="M15 6l-6 6l6 6"></path>
                            </svg>
                        </a>
                    </li>
                    <li class="page-item" ng-repeat="p in [].constructor(getTotalPages()) track by $index"
                        ng-class="{'active': currentPage === $index + 1}">
                        <a class="page-link" href="javascript:void(0)" ng-click="setPage($index + 1)">{{$index + 1}}</a>
                    </li>
                    <li class="page-item" ng-class="{'disabled': currentPage === getTotalPages()}">
                        <a class="page-link" href="javascript:void(0)" ng-click="setPage(currentPage + 1)">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                fill="none" stroke="currentColor" stroke-width="2" class="icon">
                                <path d="M9 6l6 6l-6 6"></path>
                            </svg>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    </div>

    <!-- Add/Edit Notice Modal -->
    <div class="modal modal-blur fade" id="noticeModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white p-3">
                    <h5 class="modal-title d-flex align-items-center fs-5 fw-bold">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" class="me-2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        {{modalTitle}}
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="noticeForm">
                        <div class="mb-3">
                            <label class="form-label required fw-bold small text-muted mb-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                    <line x1="4" y1="9" x2="20" y2="9"></line>
                                    <line x1="4" y1="15" x2="20" y2="15"></line>
                                    <line x1="10" y1="3" x2="8" y2="21"></line>
                                    <line x1="16" y1="3" x2="14" y2="21"></line>
                                </svg>
                                Title
                            </label>
                            <input type="text" class="form-control border-2 shadow-sm" ng-model="formData.title"
                                placeholder="Enter notice title" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label required fw-bold small text-muted mb-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                                Content
                            </label>
                            <textarea class="form-control border-2 shadow-sm" rows="4" ng-model="formData.content"
                                placeholder="Enter notice content" required style="resize: none;"></textarea>
                        </div>

                        <!-- Work Type and Employee in same row -->
                        <!-- Work Type and Employee in same row -->
                        <!-- Work Type and Employee in same row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label required fw-bold small text-muted mb-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    Work Type
                                </label>
                                <select class="form-select border-2 shadow-sm" ng-model="formData.workTypeFilter"
                                    ng-change="onWorkTypeChange()" required>
                                    <option value="all">All Employees</option>
                                    <option value="onsite">Onsite Only</option>
                                    <option value="remote">Remote Only</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted mb-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    Target Employees
                                </label>
                                <div class="dropdown">
                                    <button
                                        class="form-select text-start border-2 shadow-sm d-flex justify-content-between align-items-center"
                                        type="button" id="targetEmployeesDropdown" data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside" aria-expanded="false">
                                        <span ng-if="allEmployeesSelected" class="text-truncate fw-bold">
                                            All Employees
                                        </span>
                                        <span
                                            ng-if="!allEmployeesSelected && (employees | filter:{selected:true}).length === 0"
                                            class="text-muted">
                                            Select Employees...
                                        </span>
                                        <span
                                            ng-if="!allEmployeesSelected && (employees | filter:{selected:true}).length > 0"
                                            class="text-truncate fw-bold">
                                            {{ (employees | filter:{selected:true}).length }} Selected
                                        </span>
                                        <!-- Dropdown Icon (automatically added by form-select, but custom if needed) -->
                                    </button>

                                    <div class="dropdown-menu w-100 p-0 shadow-lg border-0 mt-1"
                                        aria-labelledby="targetEmployeesDropdown"
                                        style="max-height: 300px; overflow-y: auto;">
                                        <!-- Search Input -->
                                        <div class="p-2 border-bottom sticky-top bg-white">
                                            <div class="input-group input-group-sm">
                                                <span class="input-group-text bg-light border">
                                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                        <circle cx="11" cy="11" r="8"></circle>
                                                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                    </svg>
                                                </span>
                                                <input type="text" class="form-control border-start-0 focus-none"
                                                    placeholder="Search employees..." ng-model="employeeSearch"
                                                    ng-click="$event.stopPropagation()">
                                            </div>
                                        </div>

                                        <!-- All Employees Option -->
                                        <div class="px-3 py-2 border-bottom hover-bg-light cursor-pointer"
                                            ng-click="toggleAllEmployees(); $event.stopPropagation()">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="allEmployeesCheck"
                                                    ng-model="allEmployeesSelected"
                                                    ng-click="$event.stopPropagation(); toggleAllEmployees()">
                                                <label class="form-check-label fw-bold small w-100 cursor-pointer"
                                                    for="allEmployeesCheck">
                                                    All Employees
                                                </label>
                                            </div>
                                        </div>

                                        <!-- Employee List -->
                                        <div class="list-group list-group-flush">
                                            <div class="list-group-item list-group-item-action d-flex align-items-center px-3 py-2 border-0 cursor-pointer"
                                                ng-repeat="emp in employees | filter:employeeSearch"
                                                ng-click="emp.selected = !emp.selected; updateEmployeeSelection(); $event.stopPropagation()">
                                                <div class="form-check w-100 m-0">
                                                    <input class="form-check-input me-2" type="checkbox"
                                                        id="emp_dropdown_{{emp._id}}" ng-model="emp.selected"
                                                        ng-click="$event.stopPropagation(); updateEmployeeSelection()">
                                                    <label class="form-check-label small cursor-pointer"
                                                        for="emp_dropdown_{{emp._id}}">
                                                        {{emp.name}}
                                                    </label>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- No Results -->
                                        <div ng-if="(employees | filter:employeeSearch).length === 0"
                                            class="text-center text-muted small py-3">
                                            No employees found
                                        </div>
                                    </div>
                                </div>
                                <small class="form-hint mt-2 text-muted">
                                    Click to search and select multiple employees.
                                </small>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-bold small text-muted mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                    <path
                                        d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48">
                                    </path>
                                </svg>
                                Attachment (Optional)
                            </label>
                            <input type="file" class="form-control border-2 shadow-sm" id="noticeFile"
                                accept=".pdf,.jpg,.jpeg,.png"
                                onchange="angular.element(this).scope().handleFileSelect(this)">
                            <small class="form-hint text-muted d-flex align-items-center mt-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                Supported: PDF, JPG, PNG (Max 10MB)
                            </small>
                            <div ng-if="formData.existingFile"
                                class="mt-3 alert alert-info py-2 px-3 shadow-sm border-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                                <span class="fw-bold">Current:</span> {{formData.existingFile}}
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light p-3 border-top-0">
                    <button type="button" class="btn btn-light text-muted fw-bold px-4 shadow-sm"
                        data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary px-5 fw-bold shadow-sm" ng-click="submitNotice()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" class="me-2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        {{formData._id ? 'Update' : 'Create'}} Notice
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- View Notice Modal -->
    <div class="modal modal-blur fade" id="viewModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header bg-light p-3">
                    <h3 class="modal-title d-flex align-items-center fw-bold fs-3 text-dark">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" class="me-2 text-primary">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        {{viewData.title}}
                    </h3>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-5">
                        <label class="text-secondary fw-bold text-uppercase small mb-2">Notice Content</label>
                        <div class="p-4 bg-white rounded border border-2 shadow-sm"
                            style="color: #000 !important; font-size: 1rem; font-weight: 500; line-height: 1.6;">
                            {{viewData.content}}
                        </div>
                    </div>

                    <div class="row mb-5">
                        <div class="col-md-6">
                            <label class="text-secondary fw-bold text-uppercase small mb-2">Work Type</label>
                            <div>
                                <span
                                    class="badge bg-{{viewData.workTypeFilter === 'all' ? 'info' : viewData.workTypeFilter === 'onsite' ? 'success' : 'warning'}} text-white text-uppercase"
                                    style="font-size: 0.9rem; padding: 8px 14px; letter-spacing: 0.5px; color: white !important;">
                                    {{viewData.workTypeFilter}}
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="text-secondary fw-bold text-uppercase small mb-2">Targeted To</label>
                            <div style="font-size: 1rem; color: #000 !important; font-weight: 600;">
                                <span ng-if="viewData.targetEmployees && viewData.targetEmployees.length > 0">
                                    <span ng-repeat="emp in viewData.targetEmployees">
                                        {{emp.name}}<span ng-if="!$last">, </span>
                                    </span>
                                </span>
                                <span ng-if="!viewData.targetEmployees || viewData.targetEmployees.length === 0"
                                    class="fw-bold" style="color: #000 !important;">
                                    All Employees
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4" ng-if="viewData.fileUrl">
                        <label class="text-secondary fw-bold text-uppercase small mb-2">Attachment</label>
                        <div>
                            <a ng-href="{{viewData.fileUrl}}" download="{{viewData.fileName}}" target="_blank"
                                class="btn btn-outline-primary shadow-sm h-auto text-start d-flex align-items-center"
                                style="white-space: normal; word-break: break-word;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round" class="me-2 flex-shrink-0">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                <span>Download {{viewData.fileName || viewData.fileType | uppercase}}</span>
                            </a>
                        </div>
                    </div>

                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded border">
                        <div class="d-flex align-items-center">
                            <div class="avatar avatar-sm bg-primary text-white rounded-circle me-3">
                                {{viewData.createdBy.name.charAt(0)}}
                            </div>
                            <div>
                                <div class="text-dark fw-bold small">Posted by {{viewData.createdBy.name}}</div>
                                <div class="text-muted small">{{viewData.createdAt | date:'dd MMM yyyy, hh:mm a'}}</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light p-3 border-top-0">
                    <button type="button" class="btn btn-secondary px-4 fw-bold" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

</div>