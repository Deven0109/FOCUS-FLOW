<script src="/javascripts/controllers/noticeController.js"></script>
<div class="container-fluid" ng-controller="NoticeController">
    <div class="page-header d-print-none mb-3">
        <div class="row align-items-center">
            <div class="col">
                <div class="page-pretitle text-muted">COMMUNICATIONS</div>
                <h1 class="page-title mb-1">Notice Board</h1>
                <p class="text-muted mb-0 small">View and manage company notices</p>
            </div>
            <!-- HR Only: Add Notice Button -->
            <div class="col-auto" ng-if="isHR">
                <button class="btn btn-primary" ng-click="openAddModal()">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"></line>
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                    </svg>
                    Add Notice
                </button>
            </div>
        </div>
    </div>

    <div class="page-body">
        <!-- Empty State -->
        <div ng-if="notices.length === 0" class="empty">
            <div class="empty-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none"
                    stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                    <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
                    <line x1="9" y1="9" x2="10" y2="9" />
                    <line x1="9" y1="13" x2="15" y2="13" />
                    <line x1="9" y1="17" x2="15" y2="17" />
                </svg>
            </div>
            <p class="empty-title">No notices available</p>
            <p class="empty-subtitle text-muted">Click Add Notice to create your first notice</p>
        </div>

        <!-- Notices Table -->
        <div ng-if="notices.length > 0" class="card">
            <div class="table-responsive">
                <table class="table table-vcenter card-table table-hover">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Sr. No</th>
                            <th>Notice Name</th>
                            <th style="width: 120px;">Date</th>
                            <th style="width: 200px;">Targeted To</th>
                            <th style="width: 180px;">File Name</th>
                            <th style="width: 240px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="notice in notices track by notice._id">
                            <td class="text-muted">{{$index + 1}}</td>
                            <td>
                                <div class="fw-bold">{{notice.title}}</div>
                                <div class="text-muted small text-truncate" style="max-width: 400px;">
                                    {{notice.content}}
                                </div>
                            </td>
                            <td class="text-muted">
                                {{notice.createdAt | date:'dd/MM/yyyy'}}
                            </td>
                            <td>
                                <div ng-if="notice.targetEmployees && notice.targetEmployees.length > 0">
                                    <span class="text-muted small" ng-repeat="emp in notice.targetEmployees">
                                        {{emp.name}}<span ng-if="!$last">, </span>
                                    </span>
                                </div>
                                <span ng-if="!notice.targetEmployees || notice.targetEmployees.length === 0"
                                    class="text-muted small">
                                    s
                                </span>
                            </td>
                            <td>
                                <div ng-if="notice.fileName">
                                    <div class="d-flex align-items-center">
                                        <!-- PDF Icon -->
                                        <span ng-if="notice.fileType === 'pdf'" class="text-danger me-2">
                                            <i class="fa-solid fa-file-pdf"></i>
                                        </span>
                                        <!-- Image Icon -->
                                        <span ng-if="notice.fileType === 'image'" class="text-primary me-2">
                                            <i class="fa-solid fa-file-image"></i>
                                        </span>
                                        <span class="text-muted small text-truncate" style="max-width: 150px;"
                                            title="{{notice.fileName}}">
                                            {{notice.fileName}}
                                        </span>
                                    </div>
                                </div>
                                <span ng-if="!notice.fileName" class="text-muted">No file</span>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    <!-- View Button (All roles) -->
                                    <button class="btn btn-sm btn-info" ng-click="viewNotice(notice)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                        <span>View</span>
                                    </button>

                                    <!-- Edit Button (HR Only) -->
                                    <button ng-if="isHR" class="btn btn-sm btn-primary" ng-click="editNotice(notice)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                                        </svg>
                                        <span>Edit</span>
                                    </button>

                                    <!-- Delete Button (HR Only) -->
                                    <button ng-if="isHR" class="btn btn-sm btn-danger" ng-click="deleteNotice(notice)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                            stroke-linecap="round" stroke-linejoin="round" class="me-1">
                                            <polyline points="3 6 5 6 21 6"></polyline>
                                            <path
                                                d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2">
                                            </path>
                                        </svg>
                                        <span>Delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Add/Edit Notice Modal -->
    <div class="modal modal-blur fade" id="noticeModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content shadow-lg border-0">
                <div class="modal-header bg-primary text-white p-3">
                    <h5 class="modal-title d-flex align-items-center fs-5 fw-bold">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" class="me-2">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                            <polyline points="10 9 9 9 8 9"></polyline>
                        </svg>
                        {{modalTitle}}
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="noticeForm">
                        <div class="mb-3">
                            <label class="form-label required fw-bold small text-muted mb-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                    <line x1="4" y1="9" x2="20" y2="9"></line>
                                    <line x1="4" y1="15" x2="20" y2="15"></line>
                                    <line x1="10" y1="3" x2="8" y2="21"></line>
                                    <line x1="16" y1="3" x2="14" y2="21"></line>
                                </svg>
                                Title
                            </label>
                            <input type="text" class="form-control border-2 shadow-sm" ng-model="formData.title"
                                placeholder="Enter notice title" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label required fw-bold small text-muted mb-1">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                </svg>
                                Content
                            </label>
                            <textarea class="form-control border-2 shadow-sm" rows="4" ng-model="formData.content"
                                placeholder="Enter notice content" required style="resize: none;"></textarea>
                        </div>

                        <!-- Work Type and Employee in same row -->
                        <!-- Work Type and Employee in same row -->
                        <!-- Work Type and Employee in same row -->
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label required fw-bold small text-muted mb-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="12" cy="7" r="4"></circle>
                                    </svg>
                                    Work Type
                                </label>
                                <select class="form-select border-2 shadow-sm" ng-model="formData.workTypeFilter"
                                    ng-change="onWorkTypeChange()" required>
                                    <option value="all">All Employees</option>
                                    <option value="onsite">Onsite Only</option>
                                    <option value="remote">Remote Only</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold small text-muted mb-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                        fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                                        <circle cx="9" cy="7" r="4"></circle>
                                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                    </svg>
                                    Target Employees
                                </label>
                                <div class="border border-2 rounded shadow-sm bg-white overflow-hidden">
                                    <!-- Search Input -->
                                    <div class="p-2 border-bottom bg-light">
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-0">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                    viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                    stroke-width="2">
                                                    <circle cx="11" cy="11" r="8"></circle>
                                                    <path d="m21 21-4.35-4.35"></path>
                                                </svg>
                                            </span>
                                            <input type="text" class="form-control border-0 shadow-none"
                                                placeholder="Search employees..." ng-model="employeeSearch">
                                        </div>
                                    </div>
                                    <!-- Employee List -->
                                    <div style="max-height: 200px; overflow-y: auto;" class="p-0">
                                        <!-- All Employees checkbox -->
                                        <div class="form-check p-2 m-0 hover-bg-light border-bottom cursor-pointer">
                                            <input class="form-check-input ms-1" type="checkbox" id="allEmployeesCheck"
                                                ng-model="allEmployeesSelected" ng-change="toggleAllEmployees()"
                                                style="width: 1.2em; height: 1.2em; cursor: pointer;">
                                            <label class="form-check-label fw-bold ms-2 w-100 cursor-pointer small"
                                                for="allEmployeesCheck">
                                                All Employees
                                            </label>
                                        </div>

                                        <!-- Individual employee checkboxes with search filter -->
                                        <div class="list-group list-group-flush">
                                            <div class="list-group-item list-group-item-action d-flex align-items-center px-3 py-2 border-0 cursor-pointer"
                                                ng-repeat="emp in employees | filter:employeeSearch"
                                                ng-click="emp.selected = !emp.selected; updateEmployeeSelection()">
                                                <input class="form-check-input me-3" type="checkbox"
                                                    id="emp_{{emp._id}}" value="{{emp._id}}" ng-model="emp.selected"
                                                    ng-click="$event.stopPropagation(); updateEmployeeSelection()"
                                                    style="width: 1.2em; height: 1.2em; cursor: pointer;">
                                                <label class="form-check-label cursor-pointer w-100 m-0 small"
                                                    for="emp_{{emp._id}}">
                                                    {{emp.name}}
                                                </label>
                                            </div>
                                        </div>

                                        <div ng-if="(employees | filter:employeeSearch).length === 0"
                                            class="text-muted small text-center py-2">
                                            No employees found
                                        </div>
                                    </div>
                                </div>
                                <small class="form-hint mt-2">
                                    Check "All Employees" to target everyone, or select specific employees.
                                </small>
                            </div>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-bold small text-muted mb-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1 text-primary">
                                    <path
                                        d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48">
                                    </path>
                                </svg>
                                Attachment (Optional)
                            </label>
                            <input type="file" class="form-control border-2 shadow-sm" id="noticeFile"
                                accept=".pdf,.jpg,.jpeg,.png"
                                onchange="angular.element(this).scope().handleFileSelect(this)">
                            <small class="form-hint text-muted d-flex align-items-center mt-2">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-1">
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <line x1="12" y1="16" x2="12" y2="12"></line>
                                    <line x1="12" y1="8" x2="12.01" y2="8"></line>
                                </svg>
                                Supported: PDF, JPG, PNG (Max 10MB)
                            </small>
                            <div ng-if="formData.existingFile"
                                class="mt-3 alert alert-info py-2 px-3 shadow-sm border-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" class="me-2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                </svg>
                                <span class="fw-bold">Current:</span> {{formData.existingFile}}
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer bg-light p-3 border-top-0">
                    <button type="button" class="btn btn-light text-muted fw-bold px-4 shadow-sm"
                        data-bs-dismiss="modal">
                        Cancel
                    </button>
                    <button type="button" class="btn btn-primary px-5 fw-bold shadow-sm" ng-click="submitNotice()">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2" class="me-2">
                            <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        {{formData._id ? 'Update' : 'Create'}} Notice
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- View Notice Modal -->
    <div class="modal modal-blur fade" id="viewModal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">{{viewData.title}}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Content:</label>
                        <p>{{viewData.content}}</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">For:</label>
                        <span
                            class="badge bg-{{viewData.workTypeFilter === 'all' ? 'info' : viewData.workTypeFilter === 'onsite' ? 'success' : 'warning'}}">
                            {{viewData.workTypeFilter | uppercase}}
                        </span>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Targeted To:</label>
                        <div>
                            <span ng-if="viewData.targetEmployees && viewData.targetEmployees.length > 0">
                                <span ng-repeat="emp in viewData.targetEmployees">
                                    {{emp.name}}<span ng-if="!$last">, </span>
                                </span>
                            </span>
                            <span ng-if="!viewData.targetEmployees || viewData.targetEmployees.length === 0"
                                class="text-muted">
                                All Employees
                            </span>
                        </div>
                    </div>
                    <div class="mb-3" ng-if="viewData.fileUrl">
                        <label class="form-label fw-bold">Attachment:</label>
                        <div>
                            <a ng-href="{{viewData.fileUrl}}" download="{{viewData.fileName}}" target="_blank"
                                class="btn btn-outline-primary btn-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                    <polyline points="7 10 12 15 17 10"></polyline>
                                    <line x1="12" y1="15" x2="12" y2="3"></line>
                                </svg>
                                Download {{viewData.fileName || viewData.fileType | uppercase}}
                            </a>
                        </div>
                    </div>
                    <div class="text-muted small" ng-if="viewData.createdBy">
                        Posted by {{viewData.createdBy.name}} on {{viewData.createdAt | date:'dd/MM/yyyy, hh:mm a'}}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

</div>